doctype html
html
  head
    title= title
  body
    h1= title
    form(method='POST', action='/update-cobj')
      label(for='name') Name:
      input(type='text', name='name', required=true)
      br
      label(for='type') Type:
      input(type='text', name='type', required=true)
      br
      label(for='age__years_') Age (Years):
      input(type='number', name='age__years_', required=true)
      br
      button(type='submit') Submit
    br
    a(href='/') Return to the homepage
